<%- include('partials/header') %>

<% const pageUrl = page => { const params = new URLSearchParams(); if (filters.q) params.set('q', filters.q); if (filters.destination) params.set('destination', filters.destination); if (filters.minPrice !== null) params.set('minPrice', filters.minPrice); if (filters.maxPrice !== null) params.set('maxPrice', filters.maxPrice); if (filters.days) params.set('days', filters.days); params.set('page', page); return `/?${params.toString()}#all-tours`; }; %>

<section class="p-5 mb-5 text-white rounded-4" style="background: linear-gradient(rgba(0,0,0,.58), rgba(0,0,0,.58)), url('/images/tours/default-tour.svg') center/cover">
    <div class="py-4 text-center">
        <h1 class="display-5 fw-bold">Khám phá Việt Nam theo cách của bạn</h1>
        <p class="fs-5 mx-auto" style="max-width: 760px">Đặt tour phù hợp và tạo lịch trình theo điểm đến yêu thích.</p>
        <a href="/itinerary" class="btn btn-warning btn-lg fw-bold"><i class="fa-solid fa-wand-magic-sparkles"></i> Lập lịch trình</a>
    </div>
</section>

<section class="mb-5 featured-section" aria-label="Tour nổi bật">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <p class="section-kicker mb-1">Được yêu thích</p>
            <h2 class="h3 fw-bold mb-0">⭐ Tour Nổi Bật Được Đặt Nhiều Nhất</h2>
        </div>
        <% if (featuredTours.length > 1) { %>
            <div class="featured-controls d-flex gap-2">
                <button class="featured-prev" type="button" aria-label="Tour trước"><i class="fa-solid fa-arrow-left"></i></button>
                <button class="featured-next" type="button" aria-label="Tour tiếp theo"><i class="fa-solid fa-arrow-right"></i></button>
            </div>
        <% } %>
    </div>

    <% if (featuredTours.length) { %>
        <div class="swiper tourSwiper">
            <div class="swiper-wrapper">
                <% featuredTours.forEach(tour => { %>
                    <div class="swiper-slide">
                        <article class="card featured-tour-card h-100 shadow-sm overflow-hidden">
                            <img src="<%= tour.image_url %>" class="card-img-top" alt="<%= tour.title %>" loading="lazy">
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-primary align-self-start mb-2"><%= tour.destination %></span>
                                <h3 class="h5 fw-bold"><%= tour.title %></h3>
                                <p class="small text-muted mb-2"><i class="fa-regular fa-clock"></i> <%= tour.duration %></p>
                                <div class="d-flex justify-content-between align-items-center small mb-2">
                                    <span class="text-warning" aria-label="Đánh giá <%= Number(tour.average_rating).toFixed(1) %> trên 5 sao"><%= '★'.repeat(Math.round(Number(tour.average_rating))) %><%= '☆'.repeat(5 - Math.round(Number(tour.average_rating))) %></span>
                                    <span class="text-muted"><%= Number(tour.average_rating).toFixed(1) %> · <%= tour.review_count %> đánh giá</span>
                                </div>
                                <p class="small text-muted"><i class="fa-solid fa-ticket"></i> <%= tour.booking_count %> lượt đặt</p>
                                <p class="text-danger fw-bold fs-5 mt-auto"><%= Number(tour.price).toLocaleString('vi-VN') %> VNĐ</p>
                                <a href="/tour/<%= tour.id %>" class="btn btn-outline-primary w-100">Xem chi tiết</a>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
            <div class="swiper-pagination"></div>
        </div>
    <% } else { %>
        <p class="text-muted">Chưa có tour nổi bật.</p>
    <% } %>
</section>

<section id="all-tours">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <div>
            <p class="section-kicker mb-1">Chọn hành trình của bạn</p>
            <h2 class="h3 fw-bold mb-0">🗺️ Tất Cả Danh Sách Tour</h2>
        </div>
        <span class="small text-muted"><%= pagination.totalTours %> tour · 10 tour mỗi trang</span>
    </div>

    <form id="tour-filter-form" action="/#all-tours" method="GET" class="card p-3 p-lg-4 mb-4" aria-label="Lọc tour">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-3">
                <label for="tour-search" class="form-label small fw-semibold">Từ khóa</label>
                <input id="tour-search" class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Tên tour hoặc điểm đến">
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <label for="tour-destination" class="form-label small fw-semibold">Điểm đến</label>
                <select id="tour-destination" name="destination" class="form-select">
                    <option value="">Tất cả điểm đến</option>
                    <% destinations.forEach(destination => { %>
                        <option value="<%= destination %>" <%= filters.destination === destination ? 'selected' : '' %>><%= destination %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-6 col-xl-2">
                <label for="min-price" class="form-label small fw-semibold">Giá từ (VNĐ)</label>
                <input id="min-price" class="form-control" type="number" name="minPrice" min="0" step="100000" value="<%= filters.minPrice ?? '' %>" placeholder="Tối thiểu">
            </div>
            <div class="col-6 col-xl-2">
                <label for="max-price" class="form-label small fw-semibold">Giá đến (VNĐ)</label>
                <input id="max-price" class="form-control" type="number" name="maxPrice" min="0" step="100000" value="<%= filters.maxPrice ?? '' %>" placeholder="Tối đa">
            </div>
            <div class="col-6 col-xl-1">
                <label for="tour-days" class="form-label small fw-semibold">Số ngày</label>
                <input id="tour-days" class="form-control" type="number" name="days" min="1" max="30" value="<%= filters.days || '' %>" placeholder="Ngày">
            </div>
            <div class="col-6 col-xl-1 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit" aria-label="Lọc tour"><i class="fa-solid fa-magnifying-glass"></i></button>
                <a class="btn btn-outline-secondary" href="/#all-tours" aria-label="Xóa bộ lọc"><i class="fa-solid fa-xmark"></i></a>
            </div>
        </div>
    </form>

    <% if (pageTours.length) { %>
        <div class="row">
            <% pageTours.forEach(tour => { %>
                <div class="col-md-6 col-xl-4 mb-4">
                    <article class="card h-100 shadow-sm overflow-hidden">
                        <img src="<%= tour.image_url %>" class="card-img-top" style="height:220px;object-fit:cover" alt="<%= tour.title %>" loading="lazy">
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary align-self-start mb-2"><%= tour.destination %></span>
                            <h3 class="h5 fw-bold"><%= tour.title %></h3>
                            <p class="text-muted small"><i class="fa-regular fa-clock"></i> <%= tour.duration %></p>
                            <div class="d-flex justify-content-between align-items-center small mb-2">
                                <span class="text-warning" aria-label="Đánh giá <%= Number(tour.average_rating).toFixed(1) %> trên 5 sao"><%= '★'.repeat(Math.round(Number(tour.average_rating))) %><%= '☆'.repeat(5 - Math.round(Number(tour.average_rating))) %></span>
                                <span class="text-muted"><%= Number(tour.average_rating).toFixed(1) %> · <%= tour.review_count %> đánh giá</span>
                            </div>
                            <p class="text-danger fw-bold fs-5 mt-auto"><%= Number(tour.price).toLocaleString('vi-VN') %> VNĐ</p>
                            <a href="/tour/<%= tour.id %>" class="btn btn-outline-dark w-100">Xem chi tiết</a>
                        </div>
                    </article>
                </div>
            <% }) %>
        </div>

        <% if (pagination.totalPages > 1) { %>
            <nav class="d-flex justify-content-center mt-2 mb-3" aria-label="Phân trang tour">
                <ul class="pagination">
                    <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= pageUrl(Math.max(1, pagination.currentPage - 1)) %>" aria-label="Trang trước">&laquo;</a>
                    </li>
                    <% for (let page = 1; page <= pagination.totalPages; page++) { %>
                        <li class="page-item <%= page === pagination.currentPage ? 'active' : '' %>">
                            <a class="page-link" href="<%= pageUrl(page) %>"><%= page %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= pageUrl(Math.min(pagination.totalPages, pagination.currentPage + 1)) %>" aria-label="Trang sau">&raquo;</a>
                    </li>
                </ul>
            </nav>
            <p class="small text-muted text-center">Trang <%= pagination.currentPage %> / <%= pagination.totalPages %></p>
        <% } %>
    <% } else { %>
        <div class="alert alert-info"><%= pagination.totalTours ? 'Không tìm thấy tour phù hợp với bộ lọc.' : 'Hiện chưa có tour nào.' %></div>
    <% } %>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.querySelector('.tourSwiper');
        if (!slider || typeof Swiper === 'undefined') return;

        const slidesCount = slider.querySelectorAll('.swiper-slide').length;
        const canLoop = slidesCount > 3;
        new Swiper(slider, {
            slidesPerView: 1,
            spaceBetween: 16,
            loop: canLoop,
            watchOverflow: true,
            autoplay: slidesCount > 1 ? {
                delay: 3500,
                disableOnInteraction: false,
                pauseOnMouseEnter: true
            } : false,
            navigation: slidesCount > 1 ? {
                nextEl: '.featured-next',
                prevEl: '.featured-prev'
            } : false,
            pagination: slidesCount > 1 ? {
                el: '.tourSwiper .swiper-pagination',
                clickable: true
            } : false,
            breakpoints: {
                768: { slidesPerView: 2, spaceBetween: 20 },
                1200: { slidesPerView: 3, spaceBetween: 24 }
            }
        });
    });
</script>

<script>
    (() => {
        let activeRequest;

        async function refreshTourResults(url, { pushHistory = true, scroll = false } = {}) {
            activeRequest?.abort();
            activeRequest = new AbortController();
            const currentSection = document.getElementById('all-tours');
            currentSection?.classList.add('tour-results-loading');
            try {
                const response = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: activeRequest.signal
                });
                if (!response.ok) throw new Error('Không tải được danh sách tour.');
                const page = new DOMParser().parseFromString(await response.text(), 'text/html');
                const nextSection = page.getElementById('all-tours');
                const nextForm = page.getElementById('tour-filter-form');
                if (!nextSection || !nextForm || !currentSection) throw new Error('Trang kết quả không hợp lệ.');

                currentSection.replaceWith(nextSection);
                document.getElementById('tour-filter-form').replaceWith(nextForm);
                if (pushHistory) history.pushState({}, '', url);
                if (scroll) nextSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch (error) {
                if (error.name !== 'AbortError') window.location.assign(url);
            } finally {
                document.getElementById('all-tours')?.classList.remove('tour-results-loading');
            }
        }

        document.addEventListener('submit', event => {
            if (event.target.id !== 'tour-filter-form') return;
            event.preventDefault();
            const url = new URL(event.target.action, window.location.origin);
            new FormData(event.target).forEach((value, key) => {
                if (String(value).trim()) url.searchParams.set(key, value);
                else url.searchParams.delete(key);
            });
            url.hash = 'all-tours';
            refreshTourResults(url, { scroll: true });
        });

        document.addEventListener('click', event => {
            const link = event.target.closest('#all-tours .pagination a.page-link');
            if (!link || link.closest('.disabled')) return;
            const url = new URL(link.href, window.location.origin);
            if (url.origin !== window.location.origin) return;
            event.preventDefault();
            refreshTourResults(url, { scroll: true });
        });

        window.addEventListener('popstate', () => refreshTourResults(window.location.href));
    })();
</script>

<%- include('partials/footer') %>
