<%- include('partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="section-kicker mb-1">TravelSmart</p>
        <h1 class="h2 fw-bold mb-0">Bảng điều khiển</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/tours" class="btn btn-primary"><i class="fa-solid fa-map me-1"></i>Quản lý tour</a>
        <form action="/admin/logout" method="POST"><button class="btn btn-outline-secondary" type="submit">Đăng xuất</button></form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-4 h-100"><span class="small text-muted">Tổng số tour</span><strong class="display-6 text-primary"><%= tours.length %></strong></div>
    </div>
    <div class="col-md-6">
        <div class="card p-4 h-100"><span class="small text-muted">Tổng số đơn đặt</span><strong class="display-6 text-primary"><%= bookings.length %></strong></div>
    </div>
</div>

<section class="card border-0 shadow-sm mb-5">
    <div class="card-header bg-white border-0 px-4 pt-4">
        <h2 class="h5 fw-bold mb-0">Đơn đặt tour gần đây</h2>
    </div>
    <div class="table-responsive p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã</th><th>Khách hàng</th><th>Tour</th><th>Khách</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                <% if (bookings.length) { %>
                    <% bookings.forEach(booking => { %>
                        <tr>
                            <td>#<%= booking.id %></td>
                            <td><strong><%= booking.customer_name %></strong><br><small class="text-muted"><%= booking.phone %></small></td>
                            <td><%= booking.tour_title %></td>
                            <td><%= booking.number_of_guests %></td>
                            <td class="text-nowrap"><%= Number(booking.total_price).toLocaleString('vi-VN') %> VNĐ</td>
                            <td><span class="badge text-bg-light"><%= booking.status %></span></td>
                            <td class="text-nowrap">
                                <form action="/admin/booking/<%= booking.id %>/approve" method="POST" class="d-inline"><button class="btn btn-sm btn-outline-success" type="submit" aria-label="Duyệt đơn">Duyệt</button></form>
                                <form action="/admin/booking/<%= booking.id %>/cancel" method="POST" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Hủy đơn">Hủy</button></form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có đơn đặt tour.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<%- include('partials/footer') %>
