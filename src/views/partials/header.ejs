<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#176b67">
    <title>TravelSmart | Đặt tour và khám phá Việt Nam</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-travel sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/">
                <i class="fa-solid fa-compass me-2"></i>TravelSmart
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#travelNavbar" aria-controls="travelNavbar" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="travelNavbar">
                <div class="navbar-nav ms-auto align-items-lg-center gap-lg-1 py-2 py-lg-0">
                    <a class="nav-link px-lg-3" href="/">Trang chủ</a>
                    <a class="nav-link px-lg-3" href="/itinerary">Lịch trình</a>
                    <% if (user) { %>
                        <a class="nav-link px-lg-3" href="/my-bookings">Đơn đặt của tôi</a>
                        <% if (user.role === 'admin') { %>
                            <a class="nav-link px-lg-3" href="/admin/dashboard">Quản trị</a>
                        <% } %>
                        <span class="small text-muted px-lg-2"><i class="fa-regular fa-user me-1"></i><%= user.fullName %></span>
                        <form action="/logout" method="POST" class="ms-lg-2">
                            <button class="btn btn-outline-primary btn-sm" type="submit">Đăng xuất</button>
                        </form>
                    <% } else { %>
                        <a class="nav-link px-lg-3" href="/login">Đăng nhập</a>
                        <a class="btn btn-primary btn-sm ms-lg-2 px-3" href="/register">Tạo tài khoản</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="container my-4 my-lg-5">
